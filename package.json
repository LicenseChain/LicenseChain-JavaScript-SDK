{
  "name": "@licensechain/javascript-sdk",
  "version": "1.0.3",
  "description": "Official LicenseChain JavaScript SDK for license management and validation",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "license-assertion.cjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write src/**/*.js"
  },
  "keywords": [
    "license",
    "validation",
    "api",
    "sdk",
    "javascript",
    "licensechain",
    "license-management",
    "webhook",
    "authentication"
  ],
  "author": "LicenseChain Team <support@licensechain.app>",
  "license": "Elastic-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/LicenseChain/LicenseChain-JavaScript-SDK.git"
  },
  "bugs": {
    "url": "https://github.com/LicenseChain/LicenseChain-JavaScript-SDK/issues"
  },
  "homepage": "https://docs.licensechain.app/en/sdk",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "crypto-js": "^4.2.0",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^7.23.0",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/crypto-js": "^4.2.1",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^30.5.2",
    "prettier": "^3.1.0",
    "rollup": "^4.6.1",
    "rollup-plugin-dts": "^6.1.0",
    "rollup-plugin-typescript2": "^0.36.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "peerDependenciesMeta": {
    "axios": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "flatted": "3.4.4",
    "picomatch": "2.3.2",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "js-yaml": "4.3.2",
    "minimatch": "9.0.7",
    "serialize-javascript": "7.0.5",
    "@rollup/plugin-terser": {
      "serialize-javascript": "7.0.5"
    }
  }
}
